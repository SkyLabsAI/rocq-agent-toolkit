opam-version: "2.0"
synopsis: "Command-line editor for Rocq"
maintainer: ["Rodolphe Lepigre <rodolphe.lepigre@skylabs-ai.com>"]
authors: ["Rodolphe Lepigre <rodolphe.lepigre@skylabs-ai.com>"]
license: "LGPL-2.1-only"
homepage: "https://github.com/SkylabsAI/rocq-agent-toolkit"
bug-reports: "https://github.com/SkylabsAI/rocq-agent-toolkit/issues"
depends: [
  "dune" {>= "3.22"}
  "uuseg"
  "cmdliner"
  "stdlib-extra"
  "rocq-doc-manager"
  "yojson"
  "odoc" {with-doc}
]
build: [
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/SkylabsAI/rocq-agent-toolkit.git"
x-maintenance-intent: ["(latest)"]
